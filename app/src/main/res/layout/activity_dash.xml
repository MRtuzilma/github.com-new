<?xml version="1.0" encoding="utf-8"?>
<!--
  Asosiy ekran (neumorfik dizayn).
  Joylashuv kodda moslashadi: keng oynada YouTube chapda, tor oynada (Navigator yonida) — tepada.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- YouTube -->
        <FrameLayout
            android:id="@+id/videoCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/videoClip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF000000">

                <uz.avtolauncher.BgWebView
                    android:id="@+id/web"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <uz.avtolauncher.CornerMaskView
                    android:id="@+id/videoMask"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="false"
                    android:focusable="false" />

                <LinearLayout
                    android:id="@+id/videoBtns"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="6dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnVideoBack"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/video_btn"
                        android:contentDescription="back"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_back" />

                    <ImageButton
                        android:id="@+id/btnVideoHome"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/video_btn"
                        android:contentDescription="home"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_home" />

                    <ImageButton
                        android:id="@+id/btnVideoExpand"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/video_btn"
                        android:contentDescription="expand"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_fullscreen" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- Panel: tepaga/pastga surilsa ovoz o'zgaradi -->
        <uz.avtolauncher.VolumeSwipeLayout
            android:id="@+id/infoSwipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5">

            <LinearLayout
                android:id="@+id/infoColumn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/topRow"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <!-- Spidometr -->
                    <FrameLayout
                        android:id="@+id/gaugeHolder"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.15">

                        <uz.avtolauncher.SpeedGaugeView
                            android:id="@+id/gauge"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/btnBt"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_gravity="top|start"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="BT"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/gpsHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="2dp"
                            android:text="@string/gps_wait"
                            android:textSize="11sp" />
                    </FrameLayout>

                    <!-- Soat, ob-havo, kompas -->
                    <FrameLayout
                        android:id="@+id/clockCard"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <!-- Ichki tarkib: sig'masa FitLayout uni butunligicha kichraytiradi (hech narsa kesilmaydi) -->
                        <uz.avtolauncher.FitLayout
                            android:id="@+id/clockFit"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                        <LinearLayout
                            android:id="@+id/clockInner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextClock
                                android:id="@+id/timeClock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-thin"
                                android:format12Hour="HH:mm"
                                android:format24Hour="HH:mm"
                                android:includeFontPadding="false"
                                android:textSize="54sp" />

                            <TextView
                                android:id="@+id/dateClock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.04"
                                android:maxLines="1"
                                android:textSize="13sp" />

                            <!-- Ob-havo va kompas — bitta qatorda -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/weatherIcon"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🌡"
                                    android:textSize="20sp" />

                                <TextView
                                    android:id="@+id/weatherTemp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:fontFamily="sans-serif-light"
                                    android:text="—"
                                    android:textSize="22sp" />

                                <TextView
                                    android:id="@+id/weatherDesc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:maxLines="1"
                                    android:textSize="12sp" />

                                <FrameLayout
                                    android:id="@+id/compassWell"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_marginStart="12dp">

                                    <ImageView
                                        android:id="@+id/compassArrow"
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_navigation" />
                                </FrameLayout>

                                <TextView
                                    android:id="@+id/compassText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:maxLines="1"
                                    android:text="—"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Holat tugmachalari: Wi-Fi, Bluetooth, batareya, ovoz — bitta ixcham qatorda -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/wifiChip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="30dp"
                                    android:drawablePadding="4dp"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:text=""
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/btChip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="30dp"
                                    android:layout_marginStart="5dp"
                                    android:drawablePadding="4dp"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:text=""
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/batteryChip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="30dp"
                                    android:layout_marginStart="5dp"
                                    android:drawablePadding="4dp"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:text="—"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/statusText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="30dp"
                                    android:layout_marginStart="5dp"
                                    android:drawablePadding="4dp"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:text="—"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                        </uz.avtolauncher.FitLayout>

                        <ImageButton
                            android:id="@+id/btnNav"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="top|start"
                            android:layout_margin="6dp"
                            android:contentDescription="navigator"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_navigation" />

                        <ImageButton
                            android:id="@+id/btnTheme"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="6dp"
                            android:contentDescription="theme"
                            android:padding="13dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_palette" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Musiqa + ilova tugmalari -->
                <LinearLayout
                    android:id="@+id/dockCard"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPrev"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="prev"
                        android:padding="15dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_prev" />

                    <ImageButton
                        android:id="@+id/btnPlay"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:contentDescription="play"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play" />

                    <ImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="next"
                        android:padding="15dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_next" />

                    <View
                        android:id="@+id/dockDivider"
                        android:layout_width="2dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="2dp" />

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fillViewport="true"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/dockRow"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>

            <!-- Safar rejimi: katta spidometr + statistika -->
            <LinearLayout
                android:id="@+id/tripPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/tripGaugeHolder"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15">

                    <uz.avtolauncher.SpeedGaugeView
                        android:id="@+id/gaugeBig"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/btnBtTrip"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="top|start"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="BT"
                        android:textSize="14sp" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/tripStats"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical" />
            </LinearLayout>

            <uz.avtolauncher.VolumeOverlayView
                android:id="@+id/volumeOverlay"
                android:layout_width="96dp"
                android:layout_height="230dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </uz.avtolauncher.VolumeSwipeLayout>
    </LinearLayout>

    <!-- Oddiy ko'rinishga qaytish (YouTube kattalashtirilganda yoki safar rejimida) -->
    <LinearLayout
        android:id="@+id/restoreBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnRestoreNav"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Navigator"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnRestore"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Panelni qaytarish"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Batareya / ovoz: katta ko'rsatkich (bosilsa yopiladi) -->
    <FrameLayout
        android:id="@+id/statOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/statBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <uz.avtolauncher.BigStatView
                android:id="@+id/bigStat"
                android:layout_width="300dp"
                android:layout_height="300dp" />

            <TextView
                android:id="@+id/statTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/statSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- YouTube videosi to'liq oynada -->
    <FrameLayout
        android:id="@+id/fullHolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnExitFull"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/video_btn"
            android:contentDescription="exit"
            android:elevation="10dp"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </FrameLayout>
</FrameLayout>
