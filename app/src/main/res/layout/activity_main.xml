<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Fon rasmi (ixtiyoriy) -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/wallDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- CHAP: spidometr -->
        <FrameLayout
            android:id="@+id/gaugePanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:padding="12dp">

            <uz.avtolauncher.SpeedGaugeView
                android:id="@+id/gauge"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/gpsHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:text="@string/gps_wait"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- O'RTA: soat, ob-havo, kompas + musiqa -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1.3"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/clockPanel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextClock
                        android:id="@+id/timeClock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:format12Hour="HH:mm"
                        android:format24Hour="HH:mm"
                        android:includeFontPadding="false"
                        android:textSize="84sp" />

                    <TextClock
                        android:id="@+id/dateClock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="EEEE, d MMMM"
                        android:format24Hour="EEEE, d MMMM"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/weatherText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌡 —"
                            android:textSize="17sp" />

                        <ImageView
                            android:id="@+id/compassArrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_navigation" />

                        <TextView
                            android:id="@+id/compassText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="—"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/battery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="22dp"
                            android:textSize="17sp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnTheme"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="6dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="theme"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_palette" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/musicPanel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/albumArt"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:background="@drawable/art_bg"
                    android:clipToOutline="true"
                    android:importantForAccessibility="no"
                    android:padding="24dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_music" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/trackTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/no_music"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/trackArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnPrev"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:contentDescription="prev"
                            android:src="@drawable/ic_prev" />

                        <ImageButton
                            android:id="@+id/btnPlay"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="14dp"
                            android:contentDescription="play"
                            android:src="@drawable/ic_play" />

                        <ImageButton
                            android:id="@+id/btnNext"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:contentDescription="next"
                            android:src="@drawable/ic_next" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/mediaHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/media_permission"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- O'NG: ilova tugmalari (2 x 3) -->
        <LinearLayout
            android:id="@+id/tiles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
